# Production Environment Variables
# 프로덕션 배포 환경용 설정
# Git에 커밋됩니다 - 팀원들과 공유

# ⚠️ 실제 배포 시 아래 URL을 실제 서버 주소로 변경하세요

# Main API Server (Spring Boot)
# 예시: VITE_API_URL=http://192.168.1.100:8080
# 또는: VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=http://192.168.0.235:8080/api

# Gateway API Endpoint
# CloudFront를 통한 상대경로 사용 (배포 후 자동으로 CloudFront URL 기준)
# CloudFront Origin 1: S3 (정적 파일)
# CloudFront Origin 2: ALB → Gateway (API)

