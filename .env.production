# Production Environment Variables
# 프로덕션 배포 환경용 설정
# Git에 커밋됩니다 - 팀원들과 공유

# ⚠️ 실제 배포 시 아래 URL을 실제 서버 주소로 변경하세요

# Main API Server (Spring Boot)
# 예시: VITE_API_URL=http://192.168.1.100:8080
# 또는: VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=http://localhost:8080

# AI API Server
# 예시: VITE_AI_API_URL=http://192.168.1.100:8081
# 또는: VITE_AI_API_URL=https://ai-api.yourdomain.com
VITE_AI_API_URL=http://localhost:8081
