# Production Environment Variables
# 프로덕션 배포 환경용 설정
# Git에 커밋됩니다 - 팀원들과 공유

# ⚠️ Production에서는 상대경로 사용
# CloudFront가 /api/** 요청을 ALB(Gateway)로, /** 요청을 S3로 라우팅

# Gateway API Endpoint
# CloudFront를 통한 상대경로 사용 (배포 후 자동으로 CloudFront URL 기준)
# CloudFront Origin 1: S3 (정적 파일)
# CloudFront Origin 2: ALB → Gateway (API)
VITE_API_URL=

# 참고: 빈 값 = 상대경로("/api") 사용
# 로컬 테스트 시에는 .env.development 사용
